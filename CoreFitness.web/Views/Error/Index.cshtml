@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class='flex flex-col items-center justify-center p-22'>
    <img src="~/images/404-error.png" alt="">

    <h1 class='font-header text-6xl font-bold p-6'>@Model.Message</h1>

    <p class="p-4">The page you are looking for does not exists.</p>

    <div class="pt-10">
        <cf-navlink asp-controller="Home" asp-action="Index" variant="primary">Back to Hompage</cf-navlink>
    </div>
</div>