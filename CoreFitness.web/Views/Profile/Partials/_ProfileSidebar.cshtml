@model ProfileTabs

<div>
    <div class='flex flex-col gap-2 bg-white font-header font-semibold rounded-2xl overflow-hidden '>
        <div class='bg-tertiary p-5'>
            <h2>Menu Options</h2>
        </div>
        <div class='flex flex-col px-3'>
            <div class='py-5'>
                <cf-navlink asp-controller="Profile" asp-action="Index" asp-route-tab="@ProfileTabs.About"
                            css-class="@(Model == ProfileTabs.About ? "text-tertiary" : "")">
                    About Me
                </cf-navlink>
            </div>

            <hr>

            <div class='py-5'>
                <cf-navlink asp-controller="Profile" asp-action="Index" asp-route-tab="@ProfileTabs.Membership"
                            css-class="@(Model == ProfileTabs.Membership ? "text-tertiary" : "")">
                    My Membership
                </cf-navlink>
            </div>
            <hr>
            <div class='py-5'>
                <cf-navlink asp-controller="Profile" asp-action="Index" asp-route-tab="@ProfileTabs.Bookings"
                            css-class="@(Model == ProfileTabs.Bookings ? "text-tertiary" : "")">
                    My Bookings
                </cf-navlink>
            </div>
            <hr>
            <div class='py-6'>
                <form asp-controller="Auth" asp-action="SignOut" method="post">
                    <button type="submit" class="hover:cursor-pointer hover:text-tertiary">Sign Out</button>
                </form>
            </div>

        </div>
    </div>
    <div class="text-center p-4">
        <p class="text-xs">If you like to cancel your account click below</p>
    <form asp-controller="Profile" asp-action="Delete" method="post">
        <button type="submit" onclick='return confirm("Are you sure you want to delete your account?")' class="text-[#E50004] p-2 font-semibold rounded-3xl hover:cursor-pointer hover:bg-red-100">Remove
            Account</button>
        </form>
    </div>
</div>