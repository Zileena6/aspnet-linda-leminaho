@using CoreFitness.Web.ViewModels.Admin.Memberships
@model MembershipTypeFormViewModel

<div class='bg-white flex flex-col p-4'>
    <form asp-action="@(Model.IsEdit ? "Update" : "Create")" method="post" class='flex flex-col gap-4'>
        @if (Model.IsEdit)
        {
            <input type="hidden" asp-for="Id" class='bg-primary p-2 border rounded-md'>
        }
        <div class='flex flex-col'>
            <label asp-for="Name"></label>
            <input asp-for="Name" placeholder='Name' class='bg-primary p-2 border rounded-md' />
            <span asp-validation-for="Name" class="text-red-600"></span>
        </div>

        <div class='flex flex-col'>
            <label asp-for="Description"></label>
            <input asp-for="Description" placeholder='Description' class='bg-primary p-2 border rounded-md' />
            <span asp-validation-for="Description" class="text-red-600"></span>
        </div>

        <div class='flex flex-col'>
            <label asp-for="Price"></label>
            <input asp-for="Price" placeholder='Price' class='bg-primary p-2 border rounded-md' />
            <span asp-validation-for="Price" class="text-red-600"></span>
        </div>

        <div class='flex flex-col'>
            <label asp-for="SessionLimit"></label>
            <input asp-for="SessionLimit" placeholder='SessionLimit' class='bg-primary p-2 border rounded-md' />
            <span asp-validation-for="SessionLimit" class="text-red-600"></span>
        </div>

        <div class='flex flex-col'>
            <label asp-for="DurationInDays"></label>
            <input asp-for="DurationInDays" placeholder='DurationInDays' class='bg-primary p-2 border rounded-md' />
            <span asp-validation-for="DurationInDays" class="text-red-600"></span>
        </div>

        <button type="submit">@(Model.IsEdit ? "Update" : "Create")</button>
    </form>
</div>