@model ConfirmExternalAccountViewModel

<div class="flex flex-col items-center gap-10 p-10">
<h2>Create account</h2>
<p>Do you want to create an account with @Model.Email ?</p>

<form method="post" asp-action="ConfirmExternalAccount">
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="ReturnUrl" />
<div class="flex gap-10 items-center">
    <button type="submit" class="flex gap-2 items-center p-3 bg-tertiary w-fit rounded-full font-paragraph font-semibold text-[#27252F] hover:bg-lime-300">Yes, create account!</button>
    <a asp-controller="Account" asp-action="SignIn" class="flex gap-2 items-center p-3 bg-tertiary w-fit rounded-full font-paragraph font-semibold text-[#575757] hover:bg-lime-300">Cancel</a>
    </div>
</form>
</div>